# 统一换行：仓库内一律 LF，只有 Windows 启动脚本保留 CRLF。
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制，禁止任何 diff/换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.jks binary
*.apk binary
*.so binary
*.ttf binary
*.otf binary

# 反编译证据是纯文本，允许 diff；但不要统计成文档
analysis/rea/** linguist-documented
analysis/**/*.json linguist-detectable
